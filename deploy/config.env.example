# CRM Hub - Google Cloud deployment settings (NON-secret values only).
# Copy to deploy/config.env and edit:   cp deploy/config.env.example deploy/config.env
# deploy/config.env is git-ignored. Secrets are generated by deploy.sh and kept in Secret Manager.

# --- Required ---------------------------------------------------------------
PROJECT_ID="your-gcp-project-id"
REGION="us-central1"                    # e.g. us-central1, europe-west1, asia-southeast1
ADMIN_EMAIL="admin@yourcompany.com"     # first admin login (lowercase); password goes to Secret Manager

# --- Optional (defaults shown) ----------------------------------------------
SERVICE_NAME="crm-web"                  # Cloud Run service
MIGRATE_JOB_NAME="crm-migrate"          # Cloud Run job (migrations + seed)
AR_REPO="crm"                           # Artifact Registry Docker repository
SQL_INSTANCE="crm-postgres"             # Cloud SQL instance name
SQL_TIER="db-custom-1-3840"             # 1 vCPU / 3.75 GB. Cheapest dev option: db-f1-micro
SQL_VERSION="POSTGRES_16"
SQL_EDITION="ENTERPRISE"
SQL_AVAILABILITY="zonal"                # "regional" = high availability (about 2x cost)
DB_NAME="crm"
DB_USER="crm_app"
ADMIN_NAME="Administrator"

# Public URL of the app. Leave empty to use the default Cloud Run URL
# (https://<service>-<project-number>.<region>.run.app). Set this if you map a custom domain.
APP_URL=""

# Cloud Run sizing
RUN_MEMORY="1Gi"
RUN_CPU="1"
RUN_MIN_INSTANCES="0"                   # set to 1 to avoid cold starts (costs more)
RUN_MAX_INSTANCES="5"

# Security: "true" = only admins can create accounts (Settings > Users); Google sign-in only works
# for emails an admin has added. "false" = anyone who can reach the URL may sign up as a sales rep.
DISABLE_PUBLIC_SIGNUP="true"
