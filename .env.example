# CRM Hub - environment variables (placeholders only - NEVER commit real values)
# Local development: cp .env.example .env  and fill in real values.
# On Google Cloud these come from Secret Manager / Cloud Run env vars (see deploy/deploy.sh).

# PostgreSQL connection string (Prisma)
#   local:      postgresql://USER:PASSWORD@localhost:5432/crm?schema=public
#   Cloud Run:  postgresql://USER:PASSWORD@localhost/DB?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL="postgresql://crm:change-me@localhost:5432/crm?schema=public"

# Session encryption secret. Generate with:  openssl rand -base64 48
# AUTH_SECRET is the Auth.js v5 name; NEXTAUTH_SECRET is kept for compatibility. Use the same value.
AUTH_SECRET="replace-with-output-of-openssl-rand-base64-48"
NEXTAUTH_SECRET="replace-with-output-of-openssl-rand-base64-48"

# Public base URL of the app, no trailing slash. Used for OAuth redirect URIs.
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth "Web application" client (Google Cloud Console > APIs & Services > Credentials)
# Used for "Sign in with Google" AND for the Google Sheets / Drive transaction log.
GOOGLE_CLIENT_ID="PLACEHOLDER_GOOGLE_CLIENT_ID"
GOOGLE_CLIENT_SECRET="PLACEHOLDER_GOOGLE_CLIENT_SECRET"

# "true" = only admins can create users; Google sign-in limited to existing users.
DISABLE_PUBLIC_SIGNUP="true"

# Only used by scripts/seed-production.ts to create the first admin
ADMIN_EMAIL="admin@yourcompany.com"
ADMIN_PASSWORD="choose-a-strong-password-min-10-chars"
ADMIN_NAME="Administrator"
